# ========================================================
# CampusFind Full-Stack Production Environment Variables
# Use this template for setting up production deployment
# DO NOT commit real secrets or credentials to GitHub!
# ========================================================

# --------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel)
# --------------------------------------------------------
# Deployed Spring Boot REST API endpoint
VITE_API_URL=https://your-campusfind-backend.onrender.com/api

# Deployed Backend WebSocket endpoint (Use wss:// for HTTPS domains)
VITE_WS_URL=wss://your-campusfind-backend.onrender.com/ws

# Campus Administrator Support Contact (displayed in footer)
VITE_SUPPORT_EMAIL=admin@campusfind.edu

# --------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render / Railway)
# --------------------------------------------------------
# Server listening port (Render/Railway injects PORT automatically)
PORT=8081

# Production MySQL Database connection string
DATABASE_URL=jdbc:mysql://your-mysql-host.com:3306/campusfind_db?useSSL=true&requireSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DATABASE_USERNAME=your_db_username
DATABASE_PASSWORD=your_secure_db_password

# JWT Security (Must be a 256-bit / 64-character hex key or strong random secret)
JWT_SECRET=replace_with_a_secure_256_bit_random_hex_string_in_production
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated list of deployed frontend URLs)
FRONTEND_URL=https://your-campusfind-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-campusfind-app.vercel.app,http://localhost:5173

# Initial Administrator Credentials (Bootstrapped automatically on first startup)
INITIAL_ADMIN_EMAIL=admin@campusfind.edu
INITIAL_ADMIN_PASSWORD=ReplaceWithStrongPassword123!
INITIAL_ADMIN_NAME=Campus Administrator
INITIAL_ADMIN_STUDENT_ID=ADM001

# Production Flags
CAMPUSFIND_SEED_SAMPLE_DATA=false
HIBERNATE_DDL_AUTO=update

# File Storage Configuration (LOCAL or CLOUD)
STORAGE_TYPE=LOCAL
UPLOAD_DIR=./uploads

# Optional SMTP Email Service (System continues working via in-app & WebSocket alerts if disabled)
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=notifications@campusfind.edu
