{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://campusfind-api-2026.loca.lt/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://campusfind-api-2026.loca.lt/uploads/$1"
    },
    {
      "source": "/ws/(.*)",
      "destination": "https://campusfind-api-2026.loca.lt/ws/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
