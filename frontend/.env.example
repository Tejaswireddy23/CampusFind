# ========================================================
# CampusFind Frontend (Vercel) Environment Variables
# ========================================================

# Base URL of the backend REST API
# Local dev: leave empty to use Vite proxy /api
# Production: https://your-backend.onrender.com/api
VITE_API_URL=https://your-campusfind-backend.onrender.com/api

# Backend WebSocket endpoint
# Local dev: ws://localhost:8081/ws
# Production: wss://your-backend.onrender.com/ws
VITE_WS_URL=wss://your-campusfind-backend.onrender.com/ws

# Optional backend asset root URL (without trailing /api)
VITE_BACKEND_URL=https://your-campusfind-backend.onrender.com

# Campus administrator contact shown in footer
VITE_SUPPORT_EMAIL=admin@campusfind.edu
