# ========================================================
# CampusFind Backend (Render / Railway) Environment Variables
# ========================================================

# Server Listening Port (Injected automatically by Render/Railway)
PORT=8081

# Production MySQL Database Connection
DATABASE_URL=jdbc:mysql://your-mysql-host.com:3306/campusfind_db?useSSL=true&requireSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DATABASE_USERNAME=your_db_username
DATABASE_PASSWORD=your_secure_db_password

# JWT Secret (Must be at least 256-bit / 64 characters)
JWT_SECRET=replace_with_a_secure_256_bit_random_hex_string_in_production
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated list of deployed frontend domains)
FRONTEND_URL=https://your-campusfind-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-campusfind-app.vercel.app,http://localhost:5173

# Initial Administrator Credentials (Created automatically if no admin exists)
INITIAL_ADMIN_EMAIL=admin@campusfind.edu
INITIAL_ADMIN_PASSWORD=SetAStrongPasswordHere123!
INITIAL_ADMIN_NAME=Campus Administrator
INITIAL_ADMIN_STUDENT_ID=ADM001

# Production Mode Flags
CAMPUSFIND_SEED_SAMPLE_DATA=false
HIBERNATE_DDL_AUTO=update

# Storage Configuration
STORAGE_TYPE=LOCAL
UPLOAD_DIR=./uploads

# Optional Email Configuration (Safe fallback to in-app & WebSocket alerts)
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=notifications@campusfind.edu
